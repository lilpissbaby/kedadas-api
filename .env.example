# Copia a .env para Docker (docker compose lo lee solo). .env NUNCA se sube al repo.
# Para `npm run dev` con wrangler se sigue usando .dev.vars, no esto.

# --- obligatorios ---

# Atlas > Connect > Drivers > Node.js. Con el VPS tenéis IP fija: en Atlas,
# Network Access, quitad 0.0.0.0/0 y dejad sólo la IP del VPS.
# Con el perfil mongo-local:  MONGODB_URI=mongodb://mongo:27017
MONGODB_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Mínimo 32 caracteres. Genera uno:  npm run secreto
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio-de-verdad-min-32

DB_NAME=fiestas

# Dominio del frontend: cierra el CORS y es a donde vuelve el login.
ORIGEN_WEB=https://kedada.tenebrum.online

# --- login con Google (sin estos, /api/sesion/google responde 501) ---
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=....
# Obligatoria detrás de nginx: la misma URL que registres en Google Cloud Console.
# GOOGLE_REDIRECT_URI=https://kedada.tenebrum.online/api/sesion/google/callback

# --- sólo para probar ---
# Con esto cualquiera se hace pasar por cualquiera con una cabecera.
# NUNCA en el VPS con el subdominio abierto.
# MODO_DEV=1

# Quitar la caché/límites en memoria (no recomendado):
# CACHE=no
