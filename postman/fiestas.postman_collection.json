        {
          "name": "Crear evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Dev",
                "value": "{{usuarioDev}}",
                "description": "Sólo funciona con MODO_DEV=1. Te identifica sin cookie ni Google."
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/eventos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "eventos"
              ]
            },
            "description": "Necesita sesión. `creadoPor` **no se envía**: sale del token. Aunque lo mandes en el cuerpo, se ignora.\n\n`cancionUrl` sólo admite Spotify, YouTube, Apple Music, SoundCloud y Bandcamp.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Verbena del barrio\",\n  \"descripcion\": \"Con orquesta y bocadillo de calamares\",\n  \"tipo\": \"particular\",\n  \"lng\": -3.7038,\n  \"lat\": 40.4168,\n  \"empiezaEn\": \"{{enUnaHora}}\",\n  \"terminaEn\": \"{{enSeisHoras}}\",\n  \"cancionUrl\": \"https://open.spotify.com/track/4cOdK2wGLETKBW3PvgPWqT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 201\", () => pm.response.to.have.status(201));",
                  "const d = pm.response.json();",
                  "pm.collectionVariables.set(\"eventoId\", d.evento.id);",
                  "pm.test(\"el creador sale del token\", () => pm.expect(d.evento.esMio).to.be.true);",
                  "console.log(\"evento creado:\", d.evento.id);"
                ]
              }
